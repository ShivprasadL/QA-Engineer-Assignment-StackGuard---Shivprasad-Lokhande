{
  "name": "qa-assignment-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI (Sauce Demo) and API (Restful-Booker) test suite",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-anonymous --project=ui-authenticated",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-anonymous --project=ui-authenticated --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
